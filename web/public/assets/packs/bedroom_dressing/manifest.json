{
  "$comment": "Blender-built bedroom dressing models (tools/art/blender/families/bedroom_dressing.py): the cheval mirror, the dressing table, the wall mirror and the standing mirror. Listed in the base manifest's packs. Each mirror's glass maps to a `mirror` material, so the game reflects the room in it live. The dressing table slides its drawer out (`drawer_open`) while a resident gets ready.",
  "version": 1,
  "entries": {
    "model.mirror": {
      "type": "model",
      "url": "../../models/bedroom_dressing/mirror.glb",
      "materials": {
        "backing": {
          "finish": "material.finish.wood"
        },
        "brass": {
          "finish": "material.finish.metal"
        },
        "frame": {
          "finish": "material.finish.wood"
        },
        "mirror": {
          "finish": "material.finish.gloss",
          "mirror": "front"
        }
      },
      "paint": [
        {
          "material": "frame",
          "label": "Frame"
        }
      ]
    },
    "model.dressingTable": {
      "type": "model",
      "url": "../../models/bedroom_dressing/dressingTable.glb",
      "materials": {
        "case": {
          "finish": "material.finish.satin"
        },
        "gilt": {
          "finish": "material.finish.metal"
        },
        "inside": {
          "finish": "material.finish.satin"
        },
        "lotion": {
          "finish": "material.finish.gloss"
        },
        "mirror": {
          "finish": "material.finish.gloss",
          "mirror": "front"
        },
        "perfume": {
          "finish": "material.finish.gloss"
        },
        "pouf": {
          "finish": "material.finish.satin"
        },
        "table": {
          "finish": "material.finish.wood"
        },
        "table_frame": {
          "finish": "material.finish.metal"
        }
      },
      "motions": {
        "uses": {
          "getReady": "drawer_open"
        },
        "hold": 3.0
      },
      "paint": [
        {
          "material": "table",
          "label": "Table"
        },
        {
          "material": "table_frame",
          "label": "Frame"
        }
      ],
      "centre": [
        0,
        -0.003
      ]
    },
    "model.mirrorWall": {
      "type": "model",
      "url": "../../models/bedroom_dressing/mirrorWall.glb",
      "materials": {
        "brush": {
          "finish": "material.finish.gloss"
        },
        "cup": {
          "finish": "material.finish.gloss"
        },
        "mirror": {
          "finish": "material.finish.gloss",
          "mirror": "front"
        },
        "wall_frame": {
          "finish": "material.finish.metal"
        }
      },
      "paint": [
        {
          "material": "wall_frame",
          "label": "Frame"
        }
      ],
      "centre": [
        0,
        -0.385
      ]
    },
    "model.mirrorFloor": {
      "type": "model",
      "url": "../../models/bedroom_dressing/mirrorFloor.glb",
      "materials": {
        "mirror": {
          "finish": "material.finish.gloss",
          "mirror": "front"
        },
        "stand": {
          "finish": "material.finish.metal"
        },
        "stand_back": {
          "finish": "material.finish.satin"
        }
      },
      "paint": [
        {
          "material": "stand",
          "label": "Frame"
        }
      ],
      "centre": [
        0,
        -0.155
      ]
    }
  }
}
