{
  "$comment": "Blender-built lazy pack models (tools/art/blender/families/pack_lazy.py). Replaces the primitive-part placeholders of packs/lazy by key; the placeholder is kept as a fallback if a file fails to load, and the materials map onto the game's finishes so a model costs one draw call per finish group. Each moves while it is used: the bed's head rises, the pod's hood swings over, the quilt lifts, a locker door opens, the plate shakes and the tablet tilts up.",
  "version": 1,
  "entries": {
    "model.lazy.snoozecloudBed": {
      "type": "model",
      "url": "../../models/pack_lazy/snoozecloudBed.glb",
      "materials": {
        "birch": {
          "finish": "material.finish.satin"
        },
        "blush": {
          "finish": "material.finish.fabric"
        },
        "body": {
          "finish": "material.finish.satin"
        },
        "cloud": {
          "finish": "material.finish.satin"
        },
        "lilac": {
          "finish": "material.finish.fabric"
        },
        "pillow": {
          "finish": "material.finish.fabric"
        },
        "porcelain": {
          "finish": "material.finish.gloss"
        },
        "screen": {
          "finish": "material.finish.gloss"
        },
        "throw": {
          "finish": "material.finish.fabric"
        },
        "upholstery": {
          "finish": "material.finish.fabric"
        }
      },
      "motions": {
        "uses": {
          "sleepIn": "head_up"
        },
        "hold": 2
      },
      "paint": [
        {
          "material": "body",
          "label": "Body"
        },
        {
          "material": "upholstery",
          "label": "Upholstery"
        },
        {
          "material": "throw",
          "label": "Throw"
        }
      ]
    },
