    { "kind": "hobby", "label": "a hobby room", "floor": "upper", "chance": { "terrace": 0.2, "small": 0.2, "medium": 0.4, "large": 0.6 } }
  ],

  "$openPlan": "Chance that the kitchen and living room share one open space (no wall between them).",
  "openPlan": 0.25,

