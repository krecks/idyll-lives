{
  "name": "idyll-lives",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && cargo build -p sim-wasm --target wasm32-unknown-unknown --release --locked && wasm-bindgen target/wasm32-unknown-unknown/release/sim_wasm.wasm --target web --out-dir web/src/core/wasm-pkg",
    "dev": "npm run wasm && npm run voice && npm run llm && vite",
    "build": "npm run wasm && npm run voice && npm run llm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "test:sim": "cd .. && cargo test -p sim-core",
    "voice": "cd .. && cargo build -p voice-wasm --target wasm32-unknown-unknown --release --locked && wasm-bindgen target/wasm32-unknown-unknown/release/voice_wasm.wasm --target web --out-dir web/src/voice/wasm-pkg && node tools/voice/fetch.mjs",
    "test:voice": "cd .. && cargo test -p voice --release",
    "check:voice": "node ../tools/voice/check.mjs",
    "llm": "node ../tools/llm/fetch.mjs",
    "check:llm": "node ../tools/llm/check.mjs",
    "devices:llm": "node ../tools/llm/devices.mjs",
    "assets": "node ../tools/assets/optimize.mjs",
    "decoders": "node ../tools/assets/decoders.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@babylonjs/loaders": "9.30.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "binaryen": "132.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
